# PaperVault 配置示例
#
# 用法：复制成 .env 再填内容。.env 已被 .gitignore 忽略，不会提交到 git。
#
# 优先级：进程环境变量  >  .env 文件  >  应用内「设置」页
# 被 .env 接管的字段，在设置页里会显示「由 .env 提供」并且输入框不可编辑。
#
# 查找顺序（靠前的优先）：
#   1. ~/Library/Application Support/papervault/.env   ← 打包后推荐放这里
#   2. <项目根目录>/.env                                ← 开发时最顺手

# ── 大模型服务（任意 OpenAI 兼容接口）───────────────────────────
PAPERVAULT_LLM_BASE_URL=https://api.zhizengzeng.com/v1
PAPERVAULT_LLM_API_KEY=
PAPERVAULT_LLM_MODEL=deepseek-v4-flash

# 可选
# PAPERVAULT_LLM_TEMPERATURE=0.3
# PAPERVAULT_LLM_MAX_TOKENS=8192

# 可选：服务商特有的额外请求参数（原样并进 chat/completions 的 body）。
# 各家的「开关」不在 OpenAI 兼容协议里，只能这样传：
#   智谱 GLM-5 系列开思考   {"thinking":{"type":"enabled"}}
# Coding 会员端点示例：
# PAPERVAULT_LLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
# PAPERVAULT_LLM_MODEL=glm-5.4
#   通义千问关思考          {"enable_thinking":false}
# ⚠️ 值必须是**裸 JSON，不要加引号** —— .env 解析器会把引号当字符串边界，
#    写成 "{"thinking":...}" 只会解析出一个 `{`。
# 开了思考之后记得把 max_tokens 放宽（思考的 token 也从这个预算里扣）。
# PAPERVAULT_LLM_EXTRA_BODY={"thinking":{"type":"enabled"}}

# ── 也兼容 OpenAI 的通用变量名（上面没填时才会用到）──────────────
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ── 知识库目录 ────────────────────────────────────────────────
# 只在「首次启动、还没选过目录」时作为默认值；之后以应用内的选择为准。
# PAPERVAULT_VAULT_PATH=/Users/you/Documents/PaperVault
